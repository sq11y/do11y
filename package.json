{
  "name": "do11y",
  "version": "0.6.3",
  "description": "A bare-bones tool to document Vue components.",
  "keywords": [
    "docs-generator",
    "markdown",
    "shiki",
    "story",
    "vite",
    "vue"
  ],
  "license": "MIT",
  "repository": "github:sq11y/do11y",
  "bin": "./dist/docs/cli.js",
  "files": [
    "dist",
    "src/types.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./types": "./src/types.d.ts"
  },
  "scripts": {
    "dev": "pnpm run -r dev",
    "preview": "pnpm run -r preview",
    "build:node": "tsc --p tsconfig.node.json && copyfiles -f src/docs/html/index.html dist/docs/html",
    "build:client": "vue-tsc --build && vite build",
    "build:example": "pnpm run -r --filter do11y-example build",
    "build": "pnpm '/^build:.*/'",
    "lint": "oxlint . --fix && eslint",
    "fmt": "oxfmt .",
    "prepublishOnly": "pnpm build:node && pnpm build:client"
  },
  "dependencies": {
    "@mdit-vue/plugin-component": "^3.0.2",
    "@mdit-vue/plugin-frontmatter": "^3.0.2",
    "@mdit-vue/plugin-sfc": "^3.0.2",
    "@shikijs/transformers": "^4.3.1",
    "change-case": "^5.4.4",
    "front-matter": "^4.0.2",
    "jsdom": "^30.0.1",
    "markdown-it": "^14.3.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-replace-link": "^1.2.2",
    "shiki": "^4.3.1",
    "tinyglobby": "^0.2.17",
    "v-custom-block": "catalog:",
    "vue-component-meta": "^3.3.8",
    "vue-docgen-api": "^4.79.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "catalog:",
    "@vue/tsconfig": "catalog:",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-config-sq11y": "^0.0.4",
    "jiti": "^2.7.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.6.0"
}
